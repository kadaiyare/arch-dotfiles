# Powerlevel10k (見た目) の設定読み込み
echo 'source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme' >> ~/.zshrc
echo '[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh' >> ~/.zshrc

# プラグイン (補完・ハイライト) の読み込み
echo 'source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' >> ~/.zshrc
echo 'source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh' >> ~/.zshrc

echo "alias ls='eza --icons --git --group-directories-first'" >> ~/.zshrc
echo "alias ll='eza --icons --git --group-directories-first -l'" >> ~/.zshrc
echo "alias la='eza --icons --git --group-directories-first -la'" >> ~/.zshrc

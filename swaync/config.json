{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "control-center-width": 400,
  "fit-to-screen": true,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 100,
      "image-radius": 10
    },
    "volume": {
      "label": " ",
      "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "command": "nm-connection-editor",
          "type": "normal"
        },
        {
          "label": "",
          "command": "blueman-manager",
          "type": "normal"
        },
        {
          "label": " ",
          "command": "~/.config/hypr/scripts/screenshot.sh",
          "type": "normal"
        },
        {
          "label": "",
          "command": "pidof hyprlock || hyprlock",
          "type": "normal"
        },
        {
          "label": "",
          "command": "hyprctl dispatch exit",
          "type": "normal"
        },
        {
          "label": "",
          "command": "systemctl poweroff",
          "type": "critical"
        }
      ]
    }
  }
}
{
  "edit_predictions": {
    "provider": "copilot"
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_family": "UDEV Gothic 35DZNFLG",
  "ui_font_size": 24,
  // ファイルツリーから除外するリスト
  "file_scan_exclusions": [
    "**/.git/**",
    "**/.svn/**",
    "**/.DS_Store",
    "**/node_modules/**",
    // ▼ ここから下が LaTeX の副産物 ▼
    "**/*.aux",
    "**/*.log",
    "**/*.dvi",
    "**/*.fdb_latexmk",
    "**/*.fls",
    "**/*.synctex.gz",
    "**/*.toc",
    "**/*.bbl",
    "**/*.blg",
  ],
  "buffer_font_family": "UDEV Gothic 35DZNFLG",
  "buffer_font_size": 22.0,
  "buffer_font_fallbacks": [
    "UDEVGothicNF-Regular",
    "UDEV Gothic NF",
    "Droid Sans Mono",
    "monospace",
  ],
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "model_parameters": [],
  },
  "base_keymap": "VSCode",
  "cursor_blink": true,
  "icon_theme": {"mode": "light", "light": "Catppuccin Latte", "dark": "Catppuccin Mocha"},
  "theme": {"mode": "light", "light": "Catppuccin Latte", "dark": "Catppuccin Mocha"},

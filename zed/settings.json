      "enabled": true,
      "delay_ms": 500,
    },
  },
  "terminal": {
    "shell": {
      "program": "/usr/bin/zsh",
    },
    "font_family": "UDEV Gothic 35DZNFLG",
    "line_height": "standard",
  },
  "restore_on_startup": "last_session",
  "inlay_hints": {
    "enabled": true,
  },
  "show_whitespaces": "selection",
  "languages": {
    "LaTeX": {
      "language_servers": ["texlab"],
      "format_on_save": "on",
      "soft_wrap": "editor_width",
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
  "lsp": {
    "texlab": {
      "binary": {
        "path_lookup": true,
      },
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-pdfdvi",
              "-latex=platex",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=.",
              "%f",
            ],
            "onSave": true,
            "forwardSearchAfter": true,
          },
          "forwardSearch": {
            "executable": "zathura",
            "args": ["--synctex-forward", "%l:1:%f", "%p"],
          },
          "chktex": {
            "onOpenAndSave": true,
            "onEdit": false,
          },
        },
      },
    },
  },
}

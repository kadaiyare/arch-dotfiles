//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  ARCH  
//
//  by Bina


// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/taka/.config/fastfetch/nyarch.png",
        "type": "kitty",
        "height": 13,
        "padding": {
            "top": 2,
            "right": 0
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	{
            "type": "title",
            "keyWidth": 10
        },
    "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────────────┐"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "33"  // = color3
        },
        {
            "type": "host",
            "key": " ",
            "keyColor": "33",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "33",
            "format": "{1}"
            //"temp": false, // 温度を表示しない
            //"showPeCoreCount": false // コア数の詳細を出さない
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "33"
        },
        // ★追加: Memory (使用量 / 合計 のみにフォーマット)
        {
            "type": "memory",
            "key": " ",
            "keyColor": "33",
            "format": "{1} / {2}" 
        },
        // ★追加: Storage (ルートディレクトリ / のみを表示)
        {
            "type": "disk",
            "key": " ",
            "keyColor": "33",
            "folders": "/",
            "format": "{1} / {2}"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "33"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break",
        "break"
    ]
}
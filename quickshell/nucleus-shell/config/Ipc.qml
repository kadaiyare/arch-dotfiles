import QtQuick
import Quickshell
import Quickshell.Io
import qs.services
import qs.modules.interface.settings

Scope {
    id: global

    // Track if notification has already been shown
    property bool themeNotificationShown: false

    IpcHandler {
        target: "desktop"
        function apps() { DesktopHub.openApps(); }
        function toggleApps() { DesktopHub.toggleApps(); }
        function toggleTerminal() { DesktopHub.toggleTerminal(); }
        function wallpapers() {
            DesktopHub.page = "wallpapers";
            DesktopHub.openSidebar("left");
        }
        function wallpaperStatus(): string {
            const display = Hyprland.focusedMonitor?.name ?? "";
            return JSON.stringify({
                workspace: WorkspaceWallpapers.workspaceFor(display),
                path: String(WorkspaceWallpapers.pathFor(display)),
                renderPath: String(WorkspaceWallpapers.renderPathFor(display)),
                preparing: WorkspaceWallpapers.preparing,
                cacheCount: WorkspaceWallpapers.preloadPaths.length
            });
        }
    }

    // Function to show notification once
    function notifyPredefinedTheme() {
        if (!themeNotificationShown) {
            themeNotificationShown = true
            Quickshell.execDetached([
                "notify-send",
                "Nucleus Shell",
                `You are using a predefined theme ${Config.runtime.appearance.colors.scheme}. Color generation/Light Theme is not supported for this theme.`,
                "--urgency=normal",
                "--expire-time=5000"
            ])
        }
    }

    IpcHandler {
        target: "powermenu"
        function toggle() {
            Globals.visiblility.powermenu = !Globals.visiblility.powermenu;
        }
    }

    IpcHandler {
        target: "sidebarRight"
        function toggle() {
            if (Globals.visiblility.sidebarRight)
                Globals.visiblility.sidebarRight = false;
            else
                DesktopHub.openSidebar("right");
        }
        function isOpen(): bool { return Globals.visiblility.sidebarRight; }
    }

    IpcHandler {
        function toggle() {
            Globals.visiblility.launcher = !Globals.visiblility.launcher;
        }

        target: "launcher"
    }

    IpcHandler {
        target: "sidebarLeft"
        function toggle() {
            if (Globals.visiblility.sidebarLeft)
                Globals.visiblility.sidebarLeft = false;
            else
                DesktopHub.openSidebar("left");
        }
        function isOpen(): bool { return Globals.visiblility.sidebarLeft; }
    }

    // Handle Global IPCs
    IpcHandler {
        target: "global"

        function toggleTheme() {
            SystemTheme.toggle();
        }

        function syncTheme(mode: string) {
            if (mode === "light" || mode === "dark") SystemTheme.sync(mode);
        }

        function themeStatus(): string {
            return JSON.stringify({mode: Config.runtime.appearance.theme, busy: SystemTheme.busy, error: SystemTheme.error});
        }

        function regenColors(monitorContext: string) { // requires the monitor to select the wallpaper.
            if (Config.runtime.appearance.colors.autogenerated) {
                global.displayName = monitorContext
                genThemeColors.running = true
            } else {
                notifyPredefinedTheme()
            }
        }
    }

    property string displayName: ""

    property url wallpaperPath: WorkspaceWallpapers.pathFor(displayName)

    property var genColorsCmd: {
        const m = Config.runtime.monitors
        if (!m) return []

        return Config.runtime.appearance.colors.runMatugenUserWide
            ? [
                "bash",
                Directories.scriptsPath + "/interface/gencolors.sh",
                "--user-wide",
                wallpaperPath,
                Config.runtime.appearance.colors.matugenScheme,
                Config.runtime.appearance.theme,
                Quickshell.shellPath("extras/matugen/config.toml")
            ]
            : [
                "bash",
                Directories.scriptsPath + "/interface/gencolors.sh",
                wallpaperPath,
                Config.runtime.appearance.colors.matugenScheme,
                Config.runtime.appearance.theme,
                Quickshell.shellPath("extras/matugen/config.toml")
            ]
    }



    // Process to generate colors
    Process {
        id: genThemeColors

        command: global.genColorsCmd
    }

}
